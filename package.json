{
  "name": "projeto-integrador-vi-ts",
  "version": "1.0.0",
  "private": true,
  "description": "API de produtos do Projeto Integrador VI em TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build:client && tsx watch src/index.ts",
    "build": "tsc && npm run build:client",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.browser.json --noEmit",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json --noEmit false --outDir test-build && jest --config jest.config.json --runInBand",
    "build:client": "tsc -p tsconfig.browser.json",
    "test:coverage": "npm test"
  },
  "engines": {
    "node": ">=22.8.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true,
    "esbuild@0.28.2": true
  }
}
