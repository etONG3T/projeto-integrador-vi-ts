{
  "name": "projeto-integrador-vi-ts",
  "version": "1.0.0",
  "private": true,
  "description": "API de produtos do Projeto Integrador VI em TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json --noEmit false --outDir .test-dist && node --test --experimental-test-isolation=none .test-dist/test/*.test.js"
  },
  "engines": { "node": ">=22.8.0" },
  "dependencies": { "express": "^5.2.1" },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3"
  }
}
